# ==========================================
# SAC (Sampay Aquaculture Co-Pilot) Backend Environment Configuration
# ==========================================

# Server Settings
PORT=5050
NODE_ENV=development
CORS_ORIGIN=http://localhost:5175,http://localhost:5177

# Local Database Configuration (Knex.js + MySQL)
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=sac_biofloc

# MQTT IoT Protocol Configuration
# Default: EMQX Public Cloud WebSocket broker (matches Frontend & Simulator)
# Alternative local broker: mqtt://localhost:1883 or ws://localhost:9001
MQTT_BROKER_URL=wss://broker.emqx.io:8084/mqtt
MQTT_CLIENT_ID=sac-backend-server
MQTT_USERNAME=
MQTT_PASSWORD=

# Google Gemini Generative AI Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/app/api-keys
# When empty, the backend operates in smart fallback mode without crashing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# Cron Schedules
# 07:00 AM Daily Morning Briefing & Avnimelech Biofloc Prescription
CRON_SCHEDULE_MORNING_BRIEFING=0 7 * * *
